<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp"
    tools:context=".FirstFragment">

    <TextureView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/agora_video_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.omniwheels.OmniJoystickView
        android:id="@+id/drive_joystick"
        android:layout_width="128dp"
        android:layout_height="128dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.example.omniwheels.OmniJoystickView
        android:id="@+id/turn_joystick"
        android:layout_width="128dp"
        android:layout_height="128dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/speed_controls"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/turn_joystick"
        app:layout_constraintStart_toEndOf="@id/drive_joystick">

        <TextView
            android:id="@+id/forward_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="6dp"
            android:text="Forward: 120"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/forward_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="255"
            android:progress="120" />

        <TextView
            android:id="@+id/side_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="6dp"
            android:text="Turn: 170"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/side_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="255"
            android:progress="170" />

        <TextView
            android:id="@+id/turn_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="6dp"
            android:text="Side: 180"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/turn_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="255"
            android:progress="180" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/servo_controls"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/servo_angle_value"
        app:layout_constraintEnd_toStartOf="@id/turn_joystick"
        app:layout_constraintStart_toEndOf="@id/drive_joystick"
        app:layout_constraintTop_toTopOf="@id/turn_joystick"
        app:layout_constraintVertical_chainStyle="packed">

        <SeekBar
            android:id="@+id/servo_angle_slider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="180"
            android:progress="90" />
    </LinearLayout>

    <TextView
        android:id="@+id/servo_angle_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:padding="6dp"
        android:text="Servo: 90"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/turn_joystick"
        app:layout_constraintEnd_toEndOf="@id/servo_controls"
        app:layout_constraintStart_toStartOf="@id/servo_controls"
        app:layout_constraintTop_toBottomOf="@id/servo_controls" />

    <TextView
        android:id="@+id/command_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:padding="8dp"
        android:text="CMD: no"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/mode_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/mode_camera"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Camera" />

        <Space
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/mode_screen"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Screen" />

        <Space
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/mode_joystick"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Joystick" />
    </LinearLayout>

    <TextView
        android:id="@+id/close_app"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:scaleY="0.8"
        android:text="X"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

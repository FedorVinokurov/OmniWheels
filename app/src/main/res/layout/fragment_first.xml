<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".FirstFragment">

    <TextureView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/agora_video_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.omniwheels.OmniJoystickView
        android:id="@+id/drive_joystick"
        android:layout_width="122dp"
        android:layout_height="128dp"
        android:layout_marginStart="114dp"
        android:layout_marginBottom="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.example.omniwheels.OmniJoystickView
        android:id="@+id/turn_joystick"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.omniwheels.TriangleButtonView
            android:id="@+id/camera_up_button"
            android:layout_width="88dp"
            android:layout_height="79dp"
            android:layout_marginEnd="99dp"
            android:layout_marginBottom="382dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.example.omniwheels.TriangleButtonView
            android:id="@+id/camera_down_button"
            android:layout_width="83dp"
            android:layout_height="85dp"
            android:layout_marginEnd="101dp"
            android:layout_marginBottom="243dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.example.omniwheels.TriangleButtonView
            android:id="@+id/side_left_button"
            android:layout_width="112dp"
            android:layout_height="120dp"
            android:layout_marginEnd="232dp"
            android:layout_marginBottom="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.example.omniwheels.TriangleButtonView
            android:id="@+id/side_right_button"
            android:layout_width="103dp"
            android:layout_height="120dp"
            android:layout_marginEnd="112dp"
            android:layout_marginBottom="64dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/speed_controls"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:layout_marginBottom="12dp"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1">

        <TextView
            android:id="@+id/forward_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Forward: 120"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/forward_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="255"
            android:progress="120" />

        <TextView
            android:id="@+id/side_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Left/right: 255"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/side_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="255"
            android:progress="255" />

        <TextView
            android:id="@+id/turn_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Rotate: 180"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/turn_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="255"
            android:progress="180" />

        <TextView
            android:id="@+id/turn_button_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Button turn speed: 223"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/turn_button_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="255"
            android:progress="223" />

        <TextView
            android:id="@+id/turn_button_duration_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Button turn time: 100 ms"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/turn_button_duration_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="3000"
            android:progress="100" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/servo_controls"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/servo_angle_value"
        app:layout_constraintEnd_toStartOf="@id/right_controls"
        app:layout_constraintStart_toEndOf="@id/drive_joystick"
        app:layout_constraintTop_toTopOf="@id/right_controls"
        app:layout_constraintVertical_chainStyle="packed">

        <SeekBar
            android:id="@+id/servo_angle_slider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="180"
            android:progress="90" />
    </LinearLayout>

    <TextView
        android:id="@+id/servo_angle_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:padding="6dp"
        android:text="Servo: 90"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/turn_joystick"
        app:layout_constraintEnd_toEndOf="@id/servo_controls"
        app:layout_constraintStart_toStartOf="@id/servo_controls"
        app:layout_constraintTop_toBottomOf="@id/servo_controls" />

    <FrameLayout
        android:id="@+id/debug_toggle"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="74dp"
        android:layout_marginTop="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="47dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/ui_dbg" />
    </FrameLayout>

    <TextView
        android:id="@+id/command_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:padding="8dp"
        android:text="CMD: no"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/debug_toggle" />

    <LinearLayout
        android:id="@+id/mode_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <Button
            android:id="@+id/mode_camera"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Camera" />

        <Space
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/mode_screen"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Screen" />

        <Space
            android:layout_width="24dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/mode_joystick"
            android:layout_width="160dp"
            android:layout_height="56dp"
            android:text="Joystick" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/close_app"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginTop="38dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/ui_close" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

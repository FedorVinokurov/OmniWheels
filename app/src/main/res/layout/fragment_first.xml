<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".FirstFragment">

    <TextureView
        android:id="@+id/camera_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/agora_video_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.omniwheels.OmniJoystickView
        android:id="@+id/drive_joystick"
        android:layout_width="122dp"
        android:layout_height="128dp"
        android:layout_marginStart="114dp"
        android:layout_marginBottom="64dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/drive_forward_button"
        android:layout_width="142dp"
        android:layout_height="123dp"
        android:layout_marginStart="100dp"
        android:layout_marginTop="297dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Forward"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ui_drive_forward"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/drive_backward_button"
        android:layout_width="138dp"
        android:layout_height="114dp"
        android:layout_marginStart="101dp"
        android:layout_marginTop="426dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Backward"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ui_drive_backward"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.example.omniwheels.OmniJoystickView
        android:id="@+id/turn_joystick"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/right_controls"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.omniwheels.TriangleButtonView
            android:id="@+id/camera_up_button"
            android:layout_width="110dp"
            android:layout_height="100dp"
            android:layout_marginStart="1082dp"
            android:layout_marginBottom="371dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.example.omniwheels.TriangleButtonView
            android:id="@+id/camera_down_button"
            android:layout_width="106dp"
            android:layout_height="93dp"
            android:layout_marginStart="1081dp"
            android:layout_marginBottom="238dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.example.omniwheels.TriangleButtonView
            android:id="@+id/side_left_button"
            android:layout_width="126dp"
            android:layout_height="133dp"
            android:layout_marginStart="926dp"
            android:layout_marginBottom="59dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.example.omniwheels.TriangleButtonView
            android:id="@+id/side_right_button"
            android:layout_width="113dp"
            android:layout_height="136dp"
            android:layout_marginStart="1061dp"
            android:layout_marginBottom="57dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/speed_controls"
        android:layout_width="250dp"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_bias="0.45"
        app:layout_constraintVertical_bias="0.22">

        <TextView
            android:id="@+id/forward_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Forward: 120"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/forward_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="255"
            android:progress="120" />

        <TextView
            android:id="@+id/side_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Left/right: 255"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/side_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="255"
            android:progress="255"
            android:visibility="gone" />

        <TextView
            android:id="@+id/turn_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Rotate: 180"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <SeekBar
            android:id="@+id/turn_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="255"
            android:progress="180"
            android:visibility="gone" />

        <TextView
            android:id="@+id/turn_button_speed_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Button turn speed: 223"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/turn_button_speed_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="255"
            android:progress="223" />

        <TextView
            android:id="@+id/turn_button_duration_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#99000000"
            android:padding="3dp"
            android:text="Button turn time: 100 ms"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/turn_button_duration_slider"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:max="3000"
            android:progress="100" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/servo_controls"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/servo_angle_value"
        app:layout_constraintEnd_toStartOf="@id/right_controls"
        app:layout_constraintStart_toEndOf="@id/drive_joystick"
        app:layout_constraintTop_toTopOf="@id/right_controls"
        app:layout_constraintVertical_chainStyle="packed">

        <SeekBar
            android:id="@+id/servo_angle_slider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="180"
            android:progress="90" />
    </LinearLayout>

    <TextView
        android:id="@+id/servo_angle_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:padding="6dp"
        android:text="Servo: 90"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/turn_joystick"
        app:layout_constraintEnd_toEndOf="@id/servo_controls"
        app:layout_constraintStart_toStartOf="@id/servo_controls"
        app:layout_constraintTop_toBottomOf="@id/servo_controls" />

    <FrameLayout
        android:id="@+id/debug_toggle"
        android:layout_width="72dp"
        android:layout_height="56dp"
        android:layout_marginStart="71dp"
        android:layout_marginTop="26dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:layout_width="54dp"
            android:layout_height="33dp"
            android:layout_gravity="center"
            android:background="@drawable/ui_dbg" />
    </FrameLayout>

    <TextView
        android:id="@+id/command_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#99000000"
        android:padding="8dp"
        android:text="CMD: no"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/debug_toggle" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mode_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/mode_camera"
            android:layout_width="161dp"
            android:layout_height="74dp"
            android:layout_marginStart="29dp"
            android:layout_marginTop="27dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Camera"
            android:scaleType="fitCenter"
            android:src="@drawable/start_camera"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/mode_joystick"
            android:layout_width="181dp"
            android:layout_height="72dp"
            android:layout_marginStart="193dp"
            android:layout_marginTop="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bluetooth"
            android:scaleType="fitCenter"
            android:src="@drawable/start_bluetooth"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/start_screen_logo"
            android:layout_width="270dp"
            android:layout_height="186dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="OmniWheels"
            android:scaleType="fitCenter"
            android:src="@drawable/start_screen"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/close_app"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="34dp"
        android:layout_marginBottom="486dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <View
            android:layout_width="44dp"
            android:layout_height="43dp"
            android:layout_gravity="center"
            android:background="@drawable/ui_close" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

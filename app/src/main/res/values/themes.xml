<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.OmniWheels" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#2563EB</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="Theme.OmniWheels" parent="Base.Theme.OmniWheels" />

    <style name="MotorTelemetry">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/telemetry_panel</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
